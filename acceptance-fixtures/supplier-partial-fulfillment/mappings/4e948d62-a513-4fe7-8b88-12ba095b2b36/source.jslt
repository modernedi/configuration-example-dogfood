[
  "BIG*" + .input.invoiceDate + "*" + .input.invoiceNumber + "**" + .input.purchaseOrderNumber + "~",
  "CUR*BY*" + .input.currency + "~",
  "REF*SI*" + .input.shipmentId + "~"
] + [for (.input.lines)
  "IT1*" + string(.lineNumber) + "*" + string(.quantity) + "*" + .unit + "*" +
  string(.unitPrice) + "**VN*" + .sku + "~"
] + [
  "TDS*" + string(.input.totalCents) + "~",
  "CTT*" + string(size(.input.lines)) + "~"
]
